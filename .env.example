# ==============================================================================
# CONFIGURAÇÃO DE AMBIENTE - PLATAFORMA APROVA
# ==============================================================================

# Identidade da Aplicação
APP_NAME=APROVA
APP_ENV=development
APP_PORT=3000
APP_URL=http://localhost:5173

# Segurança & Autenticação
JWT_SECRET=sua_chave_jwt_super_secreta_minimo_32_caracteres_aleatorios
JWT_EXPIRATION=7d
INVITATION_SALT=chave_adicional_para_tokens_de_convite

# Banco de Dados (PostgreSQL - Neon / Supabase / Hyperdrive)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aprova_db

# Camada de Inteligência Artificial (Google Gemini SDK)
GEMINI_API_KEY=sua_chave_gemini_aqui
AI_PROVIDER=gemini # opcoes: gemini | openai | mock

# Armazenamento de Arquivos e Editais (Cloudflare R2 ou Local)
STORAGE_PROVIDER=local # opcoes: r2 | local
R2_ACCOUNT_ID=seu_account_id_cloudflare
R2_ACCESS_KEY_ID=sua_r2_access_key
R2_SECRET_ACCESS_KEY=sua_r2_secret_key
R2_BUCKET_NAME=aprova-documents
R2_PUBLIC_URL=https://arquivos.aprova.app
